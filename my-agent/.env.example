LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice-sales-agent
LIVEKIT_OUTBOUND_TRUNK_ID=

# STT configuration (Groq by default)
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=auto
# Optional override, only if you need a custom endpoint:
# STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions

# Step 6 conversation models (LiveKit Inference)
LLM_MODEL=google/gemini-2.5-flash
TTS_MODEL=fishaudio/s2.1-pro-free

# Step 7 RAG (PostgreSQL + pgvector)
RAG_ENABLED=true
RAG_TOP_K=3
RAG_KNOWLEDGE_DIR=../knowledge

# Same Neon/PostgreSQL used by platform
DATABASE_URL=

# Embeddings provider (Groq OpenAI-compatible endpoint by default)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Optional override:
# EMBEDDING_ENDPOINT=https://api.groq.com/openai/v1/embeddings

# Step 9 WhatsApp automation
WHATSAPP_PROVIDER=disabled
# Step 10 callback scheduling
# Use an IANA timezone, for example Asia/Kolkata or America/New_York.
CALLBACK_TIMEZONE=
# Used only when the customer gives a day but no clock time.
CALLBACK_DEFAULT_HOUR=10
CALLBACK_POLL_INTERVAL_MS=30000

# Twilio credentials and the WhatsApp-enabled sender, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
MY_RESUME_TEXT_OR_URL=
MY_PHONE_NUMBER=
