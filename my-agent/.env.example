LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT configuration (Groq by default)
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=auto
# Optional override, only if you need a custom endpoint:
# STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions

# Step 6 conversation models (LiveKit Inference)
LLM_MODEL=google/gemini-2.5-flash
TTS_MODEL=fishaudio/s2.1-pro-free

# Step 7 RAG (PostgreSQL + pgvector)
RAG_ENABLED=true
RAG_TOP_K=3
RAG_KNOWLEDGE_DIR=../knowledge

# Same Neon/PostgreSQL used by platform
DATABASE_URL=

# Embeddings provider (Groq OpenAI-compatible endpoint by default)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Optional override:
# EMBEDDING_ENDPOINT=https://api.groq.com/openai/v1/embeddings
