# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL=

# Bolna API credentials.
# Get this from the Bolna dashboard. Never commit the real value.
BOLNA_API_KEY=

# Optional. Defaults to https://api.bolna.ai.
BOLNA_API_BASE_URL=https://api.bolna.ai

# Optional. Request timeout in milliseconds. Defaults to 15000.
BOLNA_REQUEST_TIMEOUT_MS=15000

# Optional. Set to 1 to run the live GET /user/me smoke check.
# Leave unset for offline fixture evals.
BOLNA_RUN_LIVE_SMOKE=

# Bolna does not sign outgoing webhooks and does not provide a webhook secret.
# Use a long random token in the webhook URL path, e.g. openssl rand -hex 32.
# Required unless BOLNA_WEBHOOK_ALLOW_UNAUTHENTICATED=1 for local development.
BOLNA_WEBHOOK_URL_TOKEN=

# Local development only. Never enable in production.
BOLNA_WEBHOOK_ALLOW_UNAUTHENTICATED=

# Optional comma-separated source IP allowlist. In production this defaults to
# Bolna's published IPs: 13.203.39.153,13.126.9.249,13.202.133.53
# Also enforce the same allowlist at the firewall/load balancer.
BOLNA_WEBHOOK_IP_ALLOWLIST=

# Optional webhook body limit in bytes. Defaults to 262144.
BOLNA_WEBHOOK_MAX_BODY_BYTES=262144

# Optional. Defaults to enabled in production and disabled in local mode.
# When enabled, terminal webhooks are checked against GET /executions/{id}.
BOLNA_WEBHOOK_VERIFY_EXECUTION=

# Step 3 — agent config-as-code.
# Public HTTPS URL that Bolna sends call webhooks to. It must include the token:
# https://your-domain/api/bolna/webhook/<BOLNA_WEBHOOK_URL_TOKEN>
BOLNA_WEBHOOK_URL=

# Optional existing agent id. Leave blank to create a new agent.
BOLNA_AGENT_ID=

# Optional version name. The config digest is always added as a tag.
BOLNA_AGENT_VERSION_NAME=elevatebox-step3

# Resolve real voice ids from the Bolna voice catalog before live apply.
BOLNA_VOICE_ID_EN=
BOLNA_VOICE_ID_HI=
BOLNA_VOICE_ID_TE=

# Optional voice overrides. Defaults are shown here.
BOLNA_VOICE_PROVIDER_EN=elevenlabs
BOLNA_VOICE_MODEL_EN=eleven_turbo_v2_5
BOLNA_VOICE_NAME_EN=Angelica
BOLNA_VOICE_PROVIDER_HI=sarvam
BOLNA_VOICE_MODEL_HI=bulbul:v3
BOLNA_VOICE_NAME_HI=Priya
BOLNA_VOICE_PROVIDER_TE=sarvam
BOLNA_VOICE_MODEL_TE=bulbul:v3
BOLNA_VOICE_NAME_TE=Anushka

# Set to 1 only when intentionally registering a live candidate version.
BOLNA_RUN_AGENT_APPLY=

# Promotion is opt-in and requires both values below after all gates pass.
BOLNA_ALLOW_PROMOTE=
BOLNA_EVAL_GATE=

# Step 4 — extraction/disposition config-as-code.
# Set both values only when intentionally applying category/disposition config
# to the pinned agent above. The script never places a phone call.
BOLNA_RUN_EXTRACTION_APPLY=

# Step 5 — knowledge grounding.
# Set both values only when intentionally uploading the canonical PDF to Bolna.
BOLNA_RUN_KNOWLEDGE_APPLY=

# Comma-separated vector ids returned by bolna:knowledge:apply. These attach
# processed knowledge bases to the next candidate agent version.
BOLNA_KNOWLEDGE_BASE_IDS=

# Step 5 — signed custom-function tools.
# Public HTTPS origin that serves /api/bolna/tools/*.
BOLNA_TOOLS_BASE_URL=

# Long random token shared with Bolna custom functions, e.g. openssl rand -hex 32.
# The same value is required by the tool route via Authorization: Bearer <token>.
BOLNA_TOOL_TOKEN=

# Optional. Defaults to Bolna's published outbound IPs.
BOLNA_TOOL_IP_ALLOWLIST=

# Optional tool body limit in bytes. Defaults to 65536.
BOLNA_TOOL_MAX_BODY_BYTES=65536

# Local development only. Never enable in production.
BOLNA_TOOL_ALLOW_UNAUTHENTICATED=

# Optional callback time fallback hour when the caller gives no time. 0-23.
CALLBACK_DEFAULT_HOUR=10

# Optional WhatsApp alert provider. Twilio is the only supported provider.
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Step 5 — signed workflow callback smoke test.
# These values resume a real workflow execution; keep BOLNA_EVAL_GATE=PASS only
# after fixture evals pass. This does not place a phone call.
BOLNA_RUN_CALLBACK_SMOKE=
BOLNA_WORKFLOW_ID=
BOLNA_CALLBACK_NODE_ID=
BOLNA_CALLBACK_PHONE=
BOLNA_CALLBACK_LEAD_ID=
BOLNA_CALLBACK_EXECUTION_ID=

# Step 6 — SIP trunk and cost-aware canary planning.
# Agent versions can pin either the default telephony provider or the SIP trunk.
# Set trunk only after a carrier trunk and number exist in Bolna.
BOLNA_TELEPHONY_PROVIDER=default

# Read-only live trunk check. No call is placed.
BOLNA_RUN_TRUNK_CHECK=
BOLNA_TRUNK_ID=

# Canary trunk plan. Gateways are host[:port[:priority]]; carrier IPs are public
# IPv4 addresses or /16-or-narrower CIDRs. Never put the carrier password here.
BOLNA_TRUNK_NAME=ElevateBox canary SIP trunk
BOLNA_TRUNK_DESCRIPTION=
BOLNA_TRUNK_PRESET=custom
BOLNA_TRUNK_INBOUND_ENABLED=1
BOLNA_TRUNK_OUTBOUND_ENABLED=1
BOLNA_TRUNK_CHANNELS=2
BOLNA_TRUNK_TRANSPORT=udp
BOLNA_TRUNK_CODECS=PCMU,PCMA
BOLNA_TRUNK_OUTBOUND_LEADING_PLUS=0
BOLNA_TRUNK_GATEWAYS=
BOLNA_TRUNK_CARRIER_IPS=
BOLNA_TRUNK_NUMBERS=
BOLNA_TRUNK_DEFAULT_AGENT_ID=
BOLNA_TRUNK_INBOUND_AGENT_ID=
BOLNA_TRUNK_AUTH_USERNAME=
BOLNA_TRUNK_AUTH_PASSWORD_ENV=BOLNA_TRUNK_AUTH_PASSWORD
# The variable named above holds the real carrier password. Leave it unset when
# the carrier authenticates Bolna by IP.
BOLNA_TRUNK_AUTH_PASSWORD=

# Offline outbound canary request and guardrails.
BOLNA_CANARY_VERSION_ID=
BOLNA_CANARY_RECIPIENT_PHONE=
BOLNA_CANARY_FROM_PHONE=
BOLNA_CANARY_LANGUAGE=en
BOLNA_CANARY_CUSTOMER_NAME=Canary caller
BOLNA_CANARY_RUN_ID=
BOLNA_CANARY_CALL_CAP_SECONDS=300
BOLNA_CANARY_PLANNED_CALLS=1
BOLNA_CANARY_MAX_CALLS=2
BOLNA_CANARY_MAX_CONCURRENT=1
BOLNA_CANARY_PREFERRED_MODELS=1

# Cost inputs. Fill from your Bolna wallet/dashboard and carrier invoice.
# Carrier charges are separate from Bolna AI and platform charges.
BOLNA_CANARY_CURRENCY=USD
BOLNA_VOICE_AI_PER_MINUTE=
BOLNA_PLATFORM_FEE_PER_MINUTE=
BOLNA_CARRIER_PER_MINUTE=
BOLNA_CARRIER_CONNECTION_FEE=0
BOLNA_CARRIER_MINIMUM_MINUTES=0
BOLNA_CARRIER_BILLING_INCREMENT_SECONDS=60
BOLNA_CANARY_MAX_COST_PER_CALL=
BOLNA_CANARY_MAX_COST=

# Step 8 — gated live canary runner. This script is SKIP by default, and
# dry-run remains the default even after opt-in. A call is placed only when
# every gate passes and BOLNA_CANARY_DRY_RUN=0 is set explicitly.
# Do not fill these in until a live canary has been authorized in review.
BOLNA_RUN_CANARY=
BOLNA_CANARY_EXPECTED_PLAN_DIGEST=
BOLNA_CANARY_AUTHORIZE=
BOLNA_CANARY_AUTHORIZED_RUN_ID=
BOLNA_CANARY_DRY_RUN=1
BOLNA_CANARY_INSPECT_FAILURES=
