# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL=

# Bolna API credentials.
# Get this from the Bolna dashboard. Never commit the real value.
BOLNA_API_KEY=

# Optional. Defaults to https://api.bolna.ai.
BOLNA_API_BASE_URL=https://api.bolna.ai

# Optional. Request timeout in milliseconds. Defaults to 15000.
BOLNA_REQUEST_TIMEOUT_MS=15000

# Optional. Set to 1 to run the live GET /user/me smoke check.
# Leave unset for offline fixture evals.
BOLNA_RUN_LIVE_SMOKE=1
