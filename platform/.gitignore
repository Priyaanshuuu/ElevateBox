# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.agents
.claude
/.windsurf

# testing
/coverage

.agents
.claude
.windsurf

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Attribution is intentionally tracked, not ignored:
#   lib/attribution.ts, app/showcase/page.tsx, and the root NOTICE carry the
#   author credit and are guarded by tests/showcase-attribution.test.ts.
#   gitignore only hides files from git; it cannot protect tracked source.
