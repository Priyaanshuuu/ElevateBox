generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadIntent {
  HOT
  WARM
  COLD
  UNKNOWN
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CallbackStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  FAILED
}

enum AutomationType {
  INTERESTED_LEAD_WHATSAPP
  CALLBACK
}

enum AutomationStatus {
  PENDING
  TRIGGERED
  COMPLETED
  FAILED
}

model Lead {
  id                String     @id @default(cuid())
  phoneNumber       String     @unique
  name              String?
  business          String?
  productCount      Int?
  budget            Float?
  timeline          String?
  features          String[]   @default([])
  intent            LeadIntent @default(UNKNOWN)

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  calls             Call[]
  callbacks         Callback[]
  automationEvents  AutomationEvent[]

  @@index([intent])
  @@index([createdAt])
}

model Call {
  id            String     @id @default(cuid())
  leadId        String

  status        CallStatus @default(INITIATED)

  startedAt     DateTime?
  endedAt       DateTime?

  transcript    String?
  summary       String?

  bolnaExecutionId String? @unique

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bolnaExecution BolnaExecution? @relation(fields: [bolnaExecutionId], references: [id], onDelete: SetNull)

  callbacks     Callback[]
  automationEvents AutomationEvent[]

  @@index([leadId])
  @@index([createdAt])
}

model Callback {
  id            String         @id @default(cuid())
  leadId        String
  callId        String?

  scheduledAt   DateTime
  status        CallbackStatus @default(SCHEDULED)

  notes         String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call          Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

model AutomationEvent {
  id            String             @id @default(cuid())
  leadId        String
  callId        String?

  type          AutomationType
  status        AutomationStatus   @default(PENDING)

  payload       Json?
  errorMessage  String?

  triggeredAt   DateTime?
  completedAt   DateTime?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call          Call?              @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([callId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model BolnaExecution {
  id                  String   @id @default(cuid())
  executionId         String   @unique
  agentId             String?
  agentVersionId      String?
  batchId             String?
  status              String
  terminationReason   String?
  errorMessage        String?
  userNumber          String?
  agentNumber         String?
  callType            String?
  provider            String?
  providerCallId      String?
  recordingUrl        String?
  conversationDuration Float?
  totalCost           Float?
  costBreakdown       Json?
  transcript          String?
  summary             String?
  extractedData       Json?
  nodeExtractedData   Json?
  telephonyData       Json?
  occurredAt          DateTime?
  bolnaCreatedAt      DateTime?
  bolnaUpdatedAt      DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  events              BolnaWebhookEvent[]
  call                Call?

  @@index([status])
  @@index([userNumber])
  @@index([agentId])
  @@index([createdAt])
}

model BolnaWebhookEvent {
  id            String   @id @default(cuid())
  dedupeKey     String   @unique
  executionId   String
  eventType     String?
  status        String?
  sourceIp      String?
  payload       Json
  headers       Json?
  receivedAt    DateTime @default(now())
  processedAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?

  execution     BolnaExecution @relation(fields: [executionId], references: [executionId], onDelete: Cascade)

  @@index([executionId])
  @@index([status])
  @@index([receivedAt])
}

model BolnaToolInvocation {
  id           String   @id @default(cuid())
  dedupeKey    String   @unique
  toolName     String
  executionId  String?
  status       String
  result       Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([toolName])
  @@index([executionId])
  @@index([createdAt])
}
